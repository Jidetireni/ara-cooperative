ENV=development
PORT=8000
FE_URL=http://localhost:3000
# Only used by the explicit owner bootstrap command.
OWNER_EMAIL=jtirenipraise@gmail.com
# Optional initial password; leave blank to print a one-time setup code instead.
# Bootstrap preserves existing passwords on subsequent runs.
OWNER_PASSWORD=

# Only used by the destructive development seeder.
ROOT_USER_EMAIL=
ROOT_USER_PASSWORD=

DB_URL=
DB_TYPE=

JWT_SECRET=

# Outgoing email (required outside ENV=development; development prints emails
# to the terminal). With RESEND_API_KEY set, mail goes through Resend's HTTPS
# API (use this on Railway, which blocks SMTP on Free/Trial/Hobby plans) and
# EMAIL_FROM is required:
#   RESEND_API_KEY=<Resend API key with sending access>
#   EMAIL_FROM=Ara Cooperative <no-reply@mail.aracoop.xyz>
# Otherwise SMTP is used; defaults are the Gmail account. Resend over SMTP:
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=587  SMTP_USERNAME=resend
#   EMAIL_PASSWORD=<Resend API key with sending access>
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
EMAIL_PASSWORD=

# Paystack (use the sk_test_ key while testing). Without a key, checkout and
# the webhook answer 503.
PAYSTACK_SECRET_KEY=
# Owner subaccount code (ACCT_...). The cooperative uses the main account.
# Required for new checkouts, even at 0% maintenance; missing configuration returns 503.
# The owner's share covers maintenance plus processing; Paystack deducts its fee there.
PAYSTACK_OWNER_SUBACCOUNT=
# Where Paystack sends the member after paying. Default: FE_URL/payments/callback
PAYSTACK_CALLBACK_URL=
PAYSTACK_BASE_URL=https://api.paystack.co
# Whole percent added on top of every online payment (0-100). Default 5.
MAINTENANCE_FEE_PERCENT=5

GOOSE_DBSTRING=
GOOSE_DRIVER=postgres
GOOSE_MIGRATION_DIR=/app/migrations/schema

# Price per share, in kobo (50000 = NGN 500).
SHARE_UNIT_PRICE=50000
